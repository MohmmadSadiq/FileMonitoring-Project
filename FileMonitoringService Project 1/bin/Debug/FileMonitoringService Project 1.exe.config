<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <!-- 1. Declare custom sections (MUST come first) -->
  <configSections>
    <section name="SourceDirectories" type="System.Configuration.NameValueSectionHandler"/>
  </configSections>

  <!-- 2. Runtime configuration -->
  <startup> 
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!-- 3. Custom section for directories -->
  <!-- List of directories to monitor -->
  <SourceDirectories>
    <!-- Use unique keys to avoid duplicates -->
  <!--
    Default values used by the service when config values are missing or invalid:
    - Source folder: C:\FileMonitoring\Source
    - Destination folder: C:\FileMonitoring\Destination
    - Log folder: C:\FileMonitoring\Logs

    Notes:
    - Set custom values in SourceDirectories and appSettings.
    - If a value is empty/invalid, the matching default is applied automatically.
    - Do not swap folder roles. Keep each path in its correct setting:
      SourceDirectories -> source folders only
      DestinationFolder -> destination folder only
      LogFolder -> log folder only
      Example: do not use C:\FileMonitoring\Source as DestinationFolder.
  -->
	  
	  
	  <!-- 
      Don't duplicate the Keys 
      if the keys is duplicated, only the last one will be used, and the previous ones will be ignored.
    -->
    <add key="Directory1" value="C:\FileMonitoring\Source" />
    <add key="Directory2" value="C:\FileMonitoring\Source5" />
  </SourceDirectories>

  <!-- 4. General application settings -->
  <appSettings>
    <!-- Destination folder where processed files will be moved -->
    <add key="DestinationFolder" value="F:\FileMonitoring\Destination" />

    <!-- Folder for storing logs -->
    <add key="LogFolder" value="D:\FileMonitoring\Logs" />
  </appSettings>

</configuration>